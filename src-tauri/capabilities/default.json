{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:app:allow-version",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://172.21.221.80:*" },
        { "url": "https://api.nbcg.me/*" },
        { "url": "https://*.cobiss.net/*" }
      ]
    }
  ]
}
